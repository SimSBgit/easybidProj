<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.easybid.mapper.EasybidMapper">

    <insert id="insertItems">
        INSERT INTO easybid_items
        (plnm_no, pbct_no, cltr_nm, ldnm_adrs, dpsl_mtd_nm, min_bid_prc, apsl_ases_avg_amt, pbct_begn_dtm, pbct_cls_dtm)
        VALUES
        <foreach collection="list" item="item" separator=",">
            (#{item.plnmNo}, #{item.pbctNo}, #{item.cltrNm}, #{item.ldnmAdrs},
             #{item.dpslMtdNm}, #{item.minBidPrc}, #{item.apslAsesAvgAmt},
             #{item.pbctBegnDtm}, #{item.pbctClsDtm})
        </foreach>
    </insert>

    <select id="findAll" resultType="com.ssb.easybid.model.EasybidItem">
        SELECT * FROM easybid_items ORDER BY pbct_no DESC
    </select>

</mapper>
