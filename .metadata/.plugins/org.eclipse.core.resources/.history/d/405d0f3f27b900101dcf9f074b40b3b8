<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.easybid.mapper.EasybidMapper">

    @Insert("""
        INSERT INTO auction_item (
            cltr_no, cltr_mnmt_no, plnm_no, pbct_no, cltr_nm, ldnm_adrs,
            dpsl_mtd_cd, dpsl_mtd_nm, min_bid_prc, apsl_ases_avg_amt,
            pbct_begn_dtm, pbct_cls_dtm, pbct_cltr_stat_nm, sido, sigungu,
            emd, ctgr_hirk_id, ctgr_hirk_id_mid, json_data
        ) VALUES (
            #{cltrNo}, #{cltrMnmtNo}, #{plnmNo}, #{pbctNo}, #{cltrNm}, #{ldnmAdrs},
            #{dpslMtdCd}, #{dpslMtdNm}, #{minBidPrc}, #{apslAsesAvgAmt},
            #{pbctBegnDtm}, #{pbctClsDtm}, #{pbctCltrStatNm}, #{sido}, #{sigungu},
            #{emd}, #{ctgrHirkId}, #{ctgrHirkIdMid}, #{jsonData}
        )
    """)
    void insert(EasybidItem item);

    @Select("SELECT * FROM auction_item ORDER BY id DESC LIMIT 50")
    List<EasybidItem> findAll();

</mapper>
