package com.easybid.mapper;

import java.util.List;

import org.apache.ibatis.annotations.Mapper;

import com.easybid.model.EasybidItem;

@Mapper
public interface EasybidMapper {

    /**
     * 물건 등록
     */
    int insert(Property property);
    
    /**
     * 물건 전체 조회
     */
    List<Property> selectAll();
    
    /**
     * 물건번호로 조회
     */
    Property selectByCltrNo(@Param("cltrNo") Long cltrNo);
    
    /**
     * 물건 수정
     */
    int update(Property property);
    
    /**
     * 물건 삭제
     */
    int delete(@Param("cltrNo") Long cltrNo);
    
    /**
     * 물건명으로 검색
     */
    List<Property> selectByCltrNm(@Param("cltrNm") String cltrNm);
}
