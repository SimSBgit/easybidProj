package com.easybid.controller;

import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;

import lombok.RequiredArgsConstructor;

@RestController
@RequiredArgsConstructor
@RequestMapping("/api/easybid")
public class EasybidRestController {

	  @GetMapping("/items")
	    public String callOnbidApi() {
	        String url = "https://api.onbid.or.kr/openapi/service/RealEstate/getRealEstateList"
	                   + "?serviceKey=여기에_인증키_입력"
	                   + "&pageNo=1&numOfRows=5";

	        RestTemplate restTemplate = new RestTemplate();
	        return restTemplate.getForObject(url, String.class);
	    }
}
