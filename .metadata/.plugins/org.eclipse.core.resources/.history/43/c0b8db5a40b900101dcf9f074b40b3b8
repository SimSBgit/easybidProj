<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.easybid.mapper.EasybidMapper">

    <resultMap id="PropertyResultMap" type="EasybidItem">
        <id property="cltrNo" column="cltr_no"/>
        <result property="cltrNm" column="cltr_nm"/>
        <result property="minBidPrc" column="min_bid_prc"/>
        <result property="pbctBegnDtm" column="pbct_begn_dtm"/>
        <result property="pbctClsDtm" column="pbct_cls_dtm"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <!-- 공통 컬럼 -->
    <sql id="propertyColumns">
        cltr_no, cltr_nm, min_bid_prc, pbct_begn_dtm, pbct_cls_dtm, 
        created_at, updated_at
    </sql>

    <!-- 물건 등록 -->
    <insert id="insert" parameterType="EasybidItem">
        INSERT INTO properties (
            cltr_no, 
            cltr_nm, 
            min_bid_prc, 
            pbct_begn_dtm, 
            pbct_cls_dtm
        ) VALUES (
            #{cltrNo}, 
            #{cltrNm}, 
            #{minBidPrc}, 
            #{pbctBegnDtm}, 
            #{pbctClsDtm}
        )
    </insert>

    <!-- 물건 전체 조회 -->
    <select id="selectAll" resultMap="PropertyResultMap">
        SELECT 
            <include refid="propertyColumns"/>
        FROM properties
        ORDER BY created_at DESC
    </select>

    <!-- 물건번호로 조회 -->
    <select id="selectByCltrNo" parameterType="long" resultMap="PropertyResultMap">
        SELECT 
            <include refid="propertyColumns"/>
        FROM properties
        WHERE cltr_no = #{cltrNo}
    </select>

    <!-- 물건 수정 -->
    <update id="update" parameterType="EasybidItem">
        UPDATE properties
        SET 
            cltr_nm = #{cltrNm},
            min_bid_prc = #{minBidPrc},
            pbct_begn_dtm = #{pbctBegnDtm},
            pbct_cls_dtm = #{pbctClsDtm}
        WHERE cltr_no = #{cltrNo}
    </update>

    <!-- 물건 삭제 -->
    <delete id="delete" parameterType="long">
        DELETE FROM properties
        WHERE cltr_no = #{cltrNo}
    </delete>

    <!-- 물건명으로 검색 -->
    <select id="selectByCltrNm" parameterType="string" resultMap="PropertyResultMap">
        SELECT 
            <include refid="propertyColumns"/>
        FROM properties
        WHERE cltr_nm LIKE CONCAT('%', #{cltrNm}, '%')
        ORDER BY created_at DESC
    </select>

</mapper>
