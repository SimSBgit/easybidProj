<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.easybid.mapper.EasybidMapper">

    <insert id="insertItem" parameterType="com.easybid.model.EasybidItem">
        INSERT INTO auction_item
        (
            plnm_no, pbct_no, pbct_cdtn_no, cltr_no, cltr_hstr_no, scrn_grp_cd,
            ctgr_full_nm, bid_mnmt_no, cltr_nm, cltr_mnmt_no, ldnm_adrs, nmrdd_adrs,
            ldnm_pnu, dpsl_mtd_cd, dpsl_mtd_nm, bid_mtd_nm, min_bid_prc, apsl_ases_avg_amt,
            fee_rate, pbct_begn_dtm, pbct_cls_dtm, pbct_cltr_stat_nm,
            uscb_cnt, iqry_cnt, goods_nm, manf, mdl, nrgt, grbx, endpc, vhcl_mlge, fuel,
            scrt_nm, tpbz, itm_nm, mmb_rgt_nm, sido, sigungu, emd, ctgr_hirk_id, ctgr_hirk_id_mid,
            json_data
        )
        VALUES
        (
            #{plnmNo}, #{pbctNo}, #{pbctCdtnNo}, #{cltrNo}, #{cltrHstrNo}, #{scrnGrpCd},
            #{ctgrFullNm}, #{bidMnmtNo}, #{cltrNm}, #{cltrMnmtNo}, #{ldnmAdrs}, #{nmrddAdrs},
            #{ldnmPnu}, #{dpslMtdCd}, #{dpslMtdNm}, #{bidMtdNm}, #{minBidPrc}, #{apslAsesAvgAmt},
            #{feeRate}, #{pbctBegnDtm}, #{pbctClsDtm}, #{pbctCltrStatNm},
            #{uscbCnt}, #{iqryCnt}, #{goodsNm}, #{manf}, #{mdl}, #{nrgt}, #{grbx}, #{endpc}, #{vhclMlge}, #{fuel},
            #{scrtNm}, #{tpbz}, #{itmNm}, #{mmbRgtNm}, #{sido}, #{sigungu}, #{emd}, #{ctgrHirkId}, #{ctgrHirkIdMid},
            #{jsonData}
        )
    </insert>

    <select id="findAll" resultType="com.easybid.model.EasybidItem">
        SELECT
          id, plnm_no AS plnmNo, pbct_no AS pbctNo, pbct_cdtn_no AS pbctCdtnNo,
          cltr_no AS cltrNo, cltr_hstr_no AS cltrHstrNo, scrn_grp_cd AS scrnGrpCd,
          ctgr_full_nm AS ctgrFullNm, bid_mnmt_no AS bidMnmtNo, cltr_nm AS cltrNm,
          cltr_mnmt_no AS cltrMnmtNo, ldnm_adrs AS ldnmAdrs, nmrdd_adrs AS nmrddAdrs,
          ldnm_pnu AS ldnmPnu, dpsl_mtd_cd AS dpslMtdCd, dpsl_mtd_nm AS dpslMtdNm,
          bid_mtd_nm AS bidMtdNm, min_bid_prc AS minBidPrc, apsl_ases_avg_amt AS apslAsesAvgAmt,
          fee_rate AS feeRate, pbct_begn_dtm AS pbctBegnDtm, pbct_cls_dtm AS pbctClsDtm,
          pbct_cltr_stat_nm AS pbctCltrStatNm, uscb_cnt AS uscbCnt, iqry_cnt AS iqryCnt,
          goods_nm AS goodsNm, manf AS manf, mdl AS mdl, nrgt AS nrgt, grbx AS grbx,
          endpc AS endpc, vhcl_mlge AS vhclMlge, fuel AS fuel, scrt_nm AS scrtNm,
          tpbz AS tpbz, itm_nm AS itmNm, mmb_rgt_nm AS mmbRgtNm, sido AS sido,
          sigungu AS sigungu, emd AS emd, ctgr_hirk_id AS ctgrHirkId, ctgr_hirk_id_mid AS ctgrHirkIdMid,
          json_data AS jsonData, created_at AS createdAt
        FROM auction_item
        ORDER BY id DESC
        LIMIT 100
    </select>

</mapper>
