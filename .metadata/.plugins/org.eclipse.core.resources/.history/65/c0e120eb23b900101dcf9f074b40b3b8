<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.easybid.mapper.EasybidItem">

  <insert id="insertAuctionItem" parameterType="map">
        INSERT INTO auction_item
        (cltr_no, cltr_mnmt_no, plnm_no, pbct_no, cltr_nm, ldnm_adrs,
         dpsl_mtd_cd, dpsl_mtd_nm, min_bid_prc, apsl_ases_avg_amt,
         pbct_begn_dtm, pbct_cls_dtm, pbct_cltr_stat_nm, json_data)
        VALUES
        (#{item.cltrNo}, #{item.cltrMnmtNo}, #{item.plnmNo}, #{item.pbctNo},
         #{item.cltrNm}, #{item.ldnmAdrs},
         #{item.dpslMtdCd}, #{item.dpslMtdNm}, 
         <choose>
           <when test="item.minBidPrc != null and item.minBidPrc != ''">#{item.minBidPrc}</when>
           <otherwise>null</otherwise>
         </choose>,
         <choose>
           <when test="item.apslAsesAvgAmt != null and item.apslAsesAvgAmt != ''">#{item.apslAsesAvgAmt}</when>
           <otherwise>null</otherwise>
         </choose>,
         #{item.pbctBegnDtm}, #{item.pbctClsDtm}, #{item.pbctCltrStatNm}, #{jsonData})
    </insert>

    <select id="findAll" resultType="com.ssb.easybid.model.EasybidItem">
        SELECT 
           cltr_no AS cltrNo,
           cltr_mnmt_no AS cltrMnmtNo,
           plnm_no AS plnmNo,
           pbct_no AS pbctNo,
           cltr_nm AS cltrNm,
           ldnm_adrs AS ldnmAdrs,
           dpsl_mtd_cd AS dpslMtdCd,
           dpsl_mtd_nm AS dpslMtdNm,
           min_bid_prc AS minBidPrc,
           apsl_ases_avg_amt AS apslAsesAvgAmt,
           pbct_begn_dtm AS pbctBegnDtm,
           pbct_cls_dtm AS pbctClsDtm
        FROM auction_item
        ORDER BY created_at DESC
        LIMIT 100
    </select>

</mapper>
